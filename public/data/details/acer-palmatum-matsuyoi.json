      "aspect": "East-facing, North-facing, West-facing",
      "moisture": "Moist but well-drained",
      "ph": "Acid, Alkaline, Neutral",
      "exposure": "Sheltered"
    },
    "attributes": {
      "plant_type": "Tree",
      "habit": "Spreading/Branched",
      "foliage": "Deciduous",
      "suggested_uses": "City/Courtyard Gardens, Cottage/Informal Garden, Patio/Container Plants",
      "hort_group_description": "Acers in this amoenum group have large, palm-shaped leaves with finely-toothed edges"
    },
    "care": {
      "cultivation": "Grow in moisture-retentive, well-drained soil in a sheltered position. Leaf colour is best in partial shade, although full sun can be tolerated if soil is reliably moist. Acer leaf scorch can be caused by lack of soil moisture or excessive exposure. Suits container cultivation but attention to watering is needed in dry spells during the growing season. Suitable for bonsai cultivation . See Japanese maple cultivation",
      "pruning": "Pruning group 1 from late autumn to midwinter only",
      "propagation": "Propagate by layering in autumn, grafting in late winter or softwood cuttings"
    },
    "resistance": {
      "pest": "May be susceptible to Acer gall mite, aphids , caterpillars and horse chestnut scale",
      "disease": "May be susceptible to Verticillium wilt , Acer leaf scorch and honey fungus"
    },
