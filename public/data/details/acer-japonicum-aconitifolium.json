  "descriptions_zh": {
    "preferred": "蕨叶枫。这个颇受欢迎且姿态醒目的品种，叶片较大，具 9-13 个深裂裂片，几乎一直分裂到叶基。每个裂片又进一步深裂，边缘不规则细裂，呈现出蕨类般的叶形。其叶形近似乌头属（Aconitum）。每个裂片内侧又几乎收窄至基部，使叶片中心显得开张通透。叶色浓绿，叶背叶脉交汇处有簇生茸毛。秋色为鲜艳的猩红色，并带有胭脂红与紫色晕染。成串的栗紫色翅果也增添了观赏性。植株生长健壮，形成圆头形小乔木，株高可达 16 英尺（5 米）。它是满月枫中体型最大的类型之一，也是适合各种尺度景观配置的优良品种之一。异名：'Maiku jaku'（意为“舞孔雀”）。"
  },
  "rhs_zh": {
    "description": "大型、丛生的落叶灌木或小乔木。叶片近圆形，具 7-11 个深裂主裂片，秋季转为绯红色。春季开红色花，悬垂于枝条下方。",
    "dimensions": {
      "height": "4-8 米",
      "spread": "4-8 米",
      "time_to_full_height": "10-20 年"
    },
    "growing_conditions": {
      "hardiness": "H6（耐寒，可耐受极寒冬季）",
      "sunlight": "全日照，半阴"
    },
    "attributes": {
      "suggested_uses": "造型性强、养护需求低"
    },
    "care": {
      "cultivation": "宜种植于湿润但排水良好的土壤中。夏季如有需要应浇水。叶色在半阴环境下表现最佳，但也可耐全日照。土壤水分不足或暴露过度都可能导致叶片焦枯。",
      "pruning": "修剪第 1 组",
      "propagation": "可采用嫁接或软枝扦插繁殖"
    },
    "resistance": {
      "pest": "可能易受槭瘿螨、蚜虫、毛虫和七叶树介壳虫危害",
      "disease": "可能易感黄萎病、槭叶焦枯病和蜜环菌病"
    }
  },
