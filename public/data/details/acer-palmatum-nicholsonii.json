  "rhs_zh": {
    "dimensions": {
      "height": "4-8 米",
      "spread": "4-8 米",
      "time_to_full_height": "10-20 年"
    },
    "growing_conditions": {
      "hardiness": "H6（耐寒，可耐受极寒冬季）"
    },
    "attributes": {
      "suggested_uses": "城市或庭院花园、乡村风或自然式花园",
      "hort_group_description": "此 matsumurae 组的槭树，叶片深裂约达叶片的四分之三，叶缘具粗齿，裂片狭长且先端尖。"
    },
    "care": {
      "cultivation": "宜栽于保水且排水良好的土壤中，并选择避风位置。半阴环境下叶色表现最佳；若土壤湿度稳定，也可耐全日照。土壤缺水或暴露过度都可能导致叶片焦边。参见 Japanese maples cultivation。",
      "pruning": "修剪第 1 组：仅限在晚秋至仲冬期间进行。",
      "propagation": "可于秋季行压条繁殖，于晚冬进行嫁接，或采用软枝扦插繁殖。"
    },
    "resistance": {
      "pest": "可能易受槭瘿螨、蚜虫、毛虫和七叶树介壳虫危害",
      "disease": "可能易感黄萎病、槭叶焦枯病和蜜环菌病"
    },
    "description": "落叶性、多分枝、开展型小乔木，高约 5 米；叶 7 裂，裂片细长狭窄，边缘具锐锯齿，先端尖，叶长宽均为 6-8 厘米。 春季叶色紫红，夏季转为浓绿色，秋季变为金黄色至深红色。"
  },
  "descriptions_zh": {
    "preferred": "该品种最突出的特征是其秋色。 春叶为良好的红色，略带紫调；夏季转为深浓绿色，随后在秋季呈现金黄色至艳丽的深红色。 叶片具七裂，通常长 6-8 厘米、宽 7-8 厘米；不过由于中间三个裂片特别狭长，整体观感会显得更长。 各裂片为长卵形，先端细尖，基部渐狭；裂片在距叶基约 1 厘米处相连。 叶缘为尖锐的重锯齿。 叶柄红色，长约 3 厘米。 'Nicholsonii' 生长势中等偏强，可长至约 5 米高、5 米宽，并逐渐形成多分枝。 Fritz K. A. von Schwerin 于 1893 年首次描述这一较为耐寒的品种。 它也曾以 'Atrodissectum' 和 'Digitatum Atropurpureum' 之名流通。 极嫩的新叶展开时表面可见一层蜡粉。 至夏末，叶色转为褐绿色，夹杂暗黄色或青铜色调。 秋色则为鲜红色至猩红色。 叶片七裂，长宽多在 5-7 厘米之间，但大小变化较大。 裂片为渐尖卵形，先端尖锐，叶缘为重锯齿。 叶柄较粗壮，长约 3 厘米。 该品种生长速度中等，成株体量不及"
  },
