  "rhs_zh": {
    "dimensions": {
      "time_to_full_height": "10-20 年"
    },
    "growing_conditions": {
      "hardiness": "H6（耐寒，可耐受极寒冬季）"
    },
    "care": {
      "pruning": "所需修剪极少；参见修剪第 1 组。仅可在晚秋至仲冬期间修剪。",
      "propagation": "可采用嫩枝扦插、压条或嫁接繁殖。",
      "cultivation": "宜栽植于保水性好、排水良好、理想情况下微酸性的土壤中，位置应避风并防止干热风吹袭。半阴环境下生长最佳，但若土壤能稳定保持湿润，也可耐全日照。春季覆盖覆盖物，尤其是容器栽培时，有助于保持土壤湿度。另见 Japanese maples cultivation。"
    },
    "resistance": {
      "pest": "可能易受槭瘿螨、蚜虫、毛虫和七叶树介壳虫危害",
      "disease": "可能易感黄萎病、槭叶焦枯病和蜜环菌病"
    },
    "description": "一种紧凑型落叶灌木或矮生小乔木，高约 1 米，株型开展，形成圆丘状树冠。 叶片较小、宽圆并具裂片，呈绿色。 新叶萌发时为浅绿色，有时叶缘带淡粉色，夏季转为深绿色，秋季再转为橙色和红色。",
    "attributes": {
      "suggested_uses": "适合用于城市/庭院花园、乡村/自然式花园、花境与花坛、低维护栽培，以及露台/容器栽培。"
    }
  },
  "descriptions_zh": {
    "preferred": "这一优美的矮生品种具极小而近圆形的叶片，通常为七至九裂，裂片呈卵状三角形，位于叶片下部，叶缘具浅锯齿。 叶色为浅绿色，叶面略有细微皱褶。 秋色为橙色与深红色。 该品种形成紧凑、圆整的灌木，株高与冠幅均可达约 1 米。"
  },
