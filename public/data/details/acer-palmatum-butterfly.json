  "descriptions_zh": {
    "preferred": "叶片较小、分裂很深，呈蓝绿色，叶缘带有不规则斑锦。'Ao kanzashi' 在叶形、斑锦表现和生长习性上与 'Tennyo-no-hoshi' 非常相似，但叶片略小，株形更紧凑。叶缘周围的浅奶油绿色斑锦不像 'Tennyo-no-hoshi' 那样容易在日照下转为粉色。其名称意为“蓝绿色边缘”，指的就是叶片。"
  },
  "rhs_zh": {
    "dimensions": {
      "time_to_full_height": "10-20 年"
    },
    "growing_conditions": {
      "hardiness": "H6（耐寒，可耐受极寒冬季）"
