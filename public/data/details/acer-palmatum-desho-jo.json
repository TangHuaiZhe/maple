  "rhs_zh": {
    "dimensions": {
      "time_to_full_height": "10-20 年"
    },
    "growing_conditions": {
      "hardiness": "H6（耐寒，可耐受极寒冬季）",
      "sunlight": "全日照，半阴"
    },
    "attributes": {
      "hort_group_description": "本 palmatum 组的槭树叶片较小，呈掌状，边缘具粗锯齿。",
      "suggested_uses": "造景观赏、乡村/自然式花园、低维护、城市/庭院花园、庭院/容器植物、岩石园"
    },
    "care": {
      "pruning": "修剪第 1 组",
      "propagation": "可采用嫁接或软枝扦插繁殖",
      "cultivation": "宜栽培于湿润但排水良好的土壤中。夏季如有需要应补充浇水。叶色在半阴环境下表现最佳，但也可耐全日照。土壤缺水、干燥风或晚春霜冻都可能导致叶片焦枯。参见 Japanese maple cultivation。"
    },
    "resistance": {
      "pest": "可能易受槭瘿螨、蚜虫、毛虫和七叶树介壳虫危害",
      "disease": "可能易感黄萎病、槭叶焦枯病和蜜环菌病"
    },
    "description": "直立、圆整的落叶灌木或小乔木，高和冠幅均可达 2.5 米。叶片裂片先端细尖，春季呈鲜艳红色，随后成熟为亮绿色，秋季再转为红色和橙色等色调。春季开小型红色花，入秋后可结翅果。"
  },
  "descriptions_zh": {
    "preferred": "这个品种以鲜艳的春叶著称。在展叶初期，新叶呈极为明亮的胭脂红色。它在短时间内色彩非常夺目，但持色性不如其他一些相关品种。'Deshojo' 在其余季节的基本叶色为悦目的浅绿色，边缘常带红铜色。'Deshojo' 存在不同选系，其中一些构成了颇具价值的栽培品种。叶片为典型 palmatum 形，裂片分离深度约达叶基的三分之二。通常为 5 裂，自中心向外放射，裂片强烈渐尖，叶缘具细锯齿。叶片长宽可达 5-6 厘米。细长叶柄最长约 4 厘米。该品种名称中的 shoj o 部分（意为“红脸猴”）容易引起混淆。'Shojo' 是红叶 palmatum 中一个古老的标准类型。上述 'Deshojo' 则是其他选育品种的基础。"
  },
