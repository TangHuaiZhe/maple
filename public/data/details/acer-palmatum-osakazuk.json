  "descriptions_zh": {
    "preferred": "Acer palmatum 'Osakazuki'- 红灯笼又名大 盃 。 在春季和夏季有七片绿色的叶子，在秋季变成火红色 的火焰。许多人认为屡获殊荣的 'Osakazuki' 是日本枫 树中秋色拥有最艳丽的猩红色的品种之一。"
  },
  "rhs_zh": {
    "dimensions": {
      "time_to_full_height": "10-20 年"
    },
    "growing_conditions": {
      "hardiness": "H6（耐寒，可耐受极寒冬季）",
      "sunlight": "全日照，半阴"
    },
    "care": {
      "cultivation": "宜种植于湿润但排水良好的土壤中。夏季如有需要应浇水。叶色在半阴环境下表现最佳，但也可耐全日照。土壤水分不足或暴露过度都可能导致叶片焦枯。",
      "pruning": "修剪第 1 组",
      "propagation": "可采用嫁接或软枝扦插繁殖"
    },
    "resistance": {
      "pest": "可能易受槭瘿螨、蚜虫、毛虫和七叶树介壳虫危害",
      "disease": "可能易感黄萎病、槭叶焦枯病和蜜环菌病"
    },
    "description": "'Ōsakazuki' 为大型落叶灌木，株形圆整。叶片较大，7 裂，平时绿色，秋季转为极鲜艳的橙红猩红色。花和果实较小，呈红色。",
    "attributes": {
      "suggested_uses": "适合乡村风或自然式花园、低维护花园、建筑感种植、城市/庭院花园、露台/容器栽培、岩石园",
      "hort_group_description": "此 amoenum 类群中的 Acer 品种具有大型掌状叶，叶缘具细锯齿。"
    }
  },
