  "descriptions_zh": {
    "preferred": "约旦也叫乔丹，是由金隐的实生种子选育而来的品种，来自意大利的 Fratelli Gilardelli苗圃，Jordan是Giordano的英文音译，是这个苗圃其中一位所有者的名字。约旦有\"赛金隐\"的美称，春天是金黄色的，在充足的光照下叶缘为红粉色。春日多晒叶色会变白，需要及时遮阴，避免出现日灼现象。夏季转为黄绿色，秋天是橙红色的。约旦直立性很强，长势旺盛，成年树高度可达4米。"
  },
  "rhs_zh": {
    "dimensions": {
      "time_to_full_height": "10-20 年"
    },
    "growing_conditions": {
      "hardiness": "H6（耐寒，可耐受极寒冬季）"
    },
    "attributes": {
      "suggested_uses": "城市/庭院花园、乡村/自然式花园、露台/容器栽培"
    },
    "care": {
      "cultivation": "在微酸性、富含腐殖质且排水良好的土壤中生长最佳，但若加入充分腐熟的有机质改良，也能适应多数土壤。炎热干燥的空气、寒风和晚霜可能导致叶片焦枯。秋季覆 mulch，可保护浅根免受寒害和干燥。参见 Japanese maple cultivation。",
      "pruning": "修剪第 1 组",
      "propagation": "可采用半成熟枝扦插或压条繁殖。"
    },
    "resistance": {
      "pest": "可能易受槭瘿螨、蚜虫、毛虫和七叶树介壳虫危害",
      "disease": "可能易感黄萎病、槭叶焦枯病和蜜环菌病"
    },
    "description": "小型、慢生、直立的乔木，最终高和冠幅可达 3 米。叶片呈扇形，具 11 个短裂片，春季新叶展开时为淡橙色，夏季转为酸橙绿色，秋季变为橙红色。春季开细小的紫红色花，晚夏结出显著的红色带翅果，果实高举于叶幕之上。"
  },
