  "descriptions_zh": {
    "preferred": "这种槭树最突出的羽状特征包括形态奇特的叶片、舒展而直立的树形，以及极为美丽的金色秋叶，某些时候几乎带有荧光感。 夏季叶色为浓绿色。 较小的叶片有 5 至 7 裂，裂片中度至较深分裂，并僵直地向外放射。 每个裂片呈披针形，渐尖为类似 'Omato' 的尖锐硬质叶尖。 耐人寻味的是，略带钝缺刻的裂缘向上卷起，几乎形成渐细的管状，裂片顶端也向上翘起。 坚硬的叶柄呈粉红红色，新梢为绿色。 这种挺直直立、花瓶状树形的树势强健，常可长到 26 英尺（8 米）或更高，适于园林种植，紧凑的株形也适合盆景。 'Kurui jishi' 与 'Okushimo' 相似，但叶片和树形更小，仅高约 6 1/2 英尺（2 米）；其名称可解释为“狂狮”。 Group—green。 类似"
  },
  "rhs_zh": {
    "growing_conditions": {
      "hardiness": "H6（耐寒，可耐受极寒冬季）"
    },
    "attributes": {
      "hort_group_description": "本 palmatum 组的槭树叶片较小，呈掌状，边缘具粗锯齿。",
      "suggested_uses": "适用于观赏型种植、城市或庭院花园、乡村或自然式花园、花境与花坛、低维护栽培、庭院容器栽培以及岩石园。"
    },
    "care": {
      "pruning": "修剪第 1 组",
      "propagation": "可采用嫁接或软枝扦插繁殖",
      "cultivation": "宜栽培于湿润但排水良好的土壤中。夏季必要时应补充浇水。叶色在半阴环境下表现最佳，但也可耐全日照。土壤水分不足或暴晒过度都可能导致叶缘焦枯。参见日本枫树栽培资料。"
    },
    "resistance": {
      "pest": "可能易受槭瘿螨、蚜虫、毛虫和七叶树介壳虫危害",
      "disease": "可能易感黄萎病、槭叶焦枯病和蜜环菌病"
    },
    "description": "花瓶状落叶灌木，枝条向上伸展，叶片呈星形并向内卷曲，叶色为绿色，秋季转为浓烈的黄色与金黄色。"
  },
