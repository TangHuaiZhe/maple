{
  "name": "japanese-maple-showcase-web",
  "version": "1.0.0",
  "description": "日本枫树展示应用最小可用 Web 骨架",
  "private": true,
  "scripts": {
    "sync-data": "node ./scripts/sync-data.mjs",
    "fetch-rhs-images": "node ./scripts/fetch-rhs-images.mjs",
    "fetch-mrmaple-images": "node ./scripts/fetch-mrmaple-images.mjs",
    "fetch-herter-images": "node ./scripts/fetch-herter-images.mjs",
    "fetch-ncsu-images": "node ./scripts/fetch-ncsu-images.mjs",
    "fetch-conifer-images": "node ./scripts/fetch-conifer-images.mjs",
    "fetch-jmac-images": "node ./scripts/fetch-jmac-images.mjs",
    "build-info:web": "node ./scripts/write-web-build-info.mjs",
    "test": "node --test src/__tests__/*.test.mjs scripts/__tests__/*.test.mjs",
    "check:data": "node ./scripts/check-data.mjs",
    "check:build": "npm run check:data && npm test && npm run build",
    "image:audit": "node ./scripts/image-audit.mjs",
    "image:thumbs": "node ./scripts/image-thumbs.mjs",
    "image:thumbs:write": "node ./scripts/image-thumbs.mjs --write",
    "sync-mini-popular-ids": "node ./scripts/sync-mini-popular-ids.mjs",
    "predev": "npm run build-info:web",
    "dev": "vite",
    "prebuild": "npm run build-info:web",
    "build": "vite build",
    "prebuild:hosting": "npm run build-info:web",
    "build:hosting": "vite build",
    "prebuild:hosting:maple": "npm run build-info:web",
    "build:hosting:maple": "VITE_PUBLIC_BASE=/maple vite build",
    "prebuild:firebase": "npm run build-info:web",
    "build:firebase": "vite build --mode firebase && node ./scripts/prepare-firebase-hosting.mjs",
    "firebase:login": "npx --yes firebase-tools@latest login",
    "firebase:projects": "npx --yes firebase-tools@latest projects:list",
    "deploy:firebase": "npm run build:firebase && npx --yes firebase-tools@latest deploy --only hosting",
    "deploy:cloudbase": "bash ./scripts/deploy-cloudbase-hosting.sh",
    "deploy:cloudbase:app": "npm run build && bash ./scripts/deploy-cloudbase-incremental.sh cloud1-d0gq8e1gidc917363 app dist",
    "deploy:cloudbase:assets": "bash ./scripts/deploy-cloudbase-incremental.sh cloud1-d0gq8e1gidc917363 assets dist",
    "deploy:cloudbase:data": "bash ./scripts/deploy-cloudbase-incremental.sh cloud1-d0gq8e1gidc917363 data dist",
    "deploy:cloudbase:image-thumbs": "npm run deploy:cloudbase:thumbs && npm run deploy:cloudbase:data",
    "deploy:cloudbase:thumbs": "bash ./scripts/deploy-cloudbase-incremental.sh cloud1-d0gq8e1gidc917363 thumbs dist",
    "deploy:cloudbase:user-images": "bash ./scripts/deploy-cloudbase-incremental.sh cloud1-d0gq8e1gidc917363 user-images data-source/Resource/园艺/raw",
    "deploy:cloudbase:source-images": "ONLY_IMAGES=1 bash ./scripts/deploy-cloudbase-hosting.sh cloud1-d0gq8e1gidc917363 / data-source/Resource/园艺/raw",
    "preview": "vite preview",
    "mini:dev": "npm run sync-mini-popular-ids && npm --prefix ./mini run dev:weapp",
    "mini:build": "npm run sync-mini-popular-ids && npm --prefix ./mini run build:weapp",
    "mini:typecheck": "npm --prefix ./mini run typecheck"
  },
  "keywords": [
    "maple",
    "garden",
    "obsidian"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "sharp": "^0.34.5",
    "vite": "^8.0.8"
  }
}
