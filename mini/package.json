{
  "name": "mini",
  "version": "1.0.6",
  "private": true,
  "description": "Japanese Maple Mini Program",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "prebuild:weapp": "node ../node_modules/tsx/dist/cli.mjs ../scripts/write-mini-build-info.ts",
    "build:weapp": "NODE_ENV=production taro build --type weapp",
    "typecheck": "tsc --noEmit",
    "prebuild:weapp:dev": "node ../node_modules/tsx/dist/cli.mjs ../scripts/write-mini-build-info.ts",
    "build:weapp:dev": "NODE_ENV=development taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp:dev -- --watch",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-alipay": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.24.0",
    "@tarojs/cli": "4.2.0",
    "@tarojs/webpack5-runner": "4.2.0",
    "@types/react": "^18.2.0",
    "babel-preset-taro": "4.2.0",
    "sass": "^1.75.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.0",
    "webpack": "5.91.0"
  }
}
